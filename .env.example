# Copia este archivo como .env y completa los valores.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# --- Base de datos MySQL/MariaDB (obligatorio) ---
# 3306 es el puerto estandar. Cambialo si tu servidor usa otro
# (por ejemplo 3307 en una instalacion de MariaDB con data dir propio).
DATAOPS_DB_HOST=127.0.0.1
DATAOPS_DB_PORT=3306
DATAOPS_DB_USER=root
DATAOPS_DB_PASSWORD=
DATAOPS_DB_NAME=dataops

# --- Proveedor de IA (opcional) ---
# local   = estadística + IsolationForest, sin claves ni internet (default)
# openai  = requiere OPENAI_API_KEY
# azure   = requiere AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_API_KEY
AI_PROVIDER=local

# --- OpenAI (opcional, solo si AI_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI (opcional, solo si AI_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- Ruta a PHP (opcional; si no, se busca en el PATH o en XAMPP) ---
# DATAOPS_PHP=C:\xampp\php\php.exe